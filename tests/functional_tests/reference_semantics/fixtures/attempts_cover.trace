# Covers of properties whose attempt result is not the obligation-level one (docs/semantics.md
# 9.2, 9.3). A cover reports an attempt only when it is TRUE and nonvacuous, once per decision
# sample (scope: attempt). The production pipeline runs these through the per-attempt machine;
# the last case is a cover that the cover rule (9.5) rejects, so only the reference runs it
# (support: oracle).

== cover_of_and_of_implications
# cover of (a |-> b) and (c |-> d): TRUE when both are, nonvacuous if either is.
# t0: both TRUE and nonvacuous: pass at 0. t1: operand 1 TRUE nonvacuous, operand 2 vacuous:
# pass at 1. t2: both vacuous: TRUE but vacuous, no pass. t3: operand 1 FALSE: FALSE (no pass).
# t4: operand 1 TRUE, operand 2 FALSE: FALSE.
property: (a |-> b) and (c |-> d)
clause: 16.12.5 16.12.7 16.14.3 16.14.8
class: interpretation I5
kind: cover
scope: attempt
sample  : 0 1 2 3 4
a       : 1 1 . 1 1
b       : 1 1 . . 1
c       : 1 . . . 1
d       : 1 . . . .
outcome : T T t F F
decided : 0 1 2 3 4
pass    : 1 1 . . .
pending: 0

== cover_of_and_of_implications_at_the_later_decision
# cover of (a |-> b) and (c |-> ##1 d): TRUE at the later of the two decisions.
# t0: operand 1 TRUE at 0, operand 2 (c at 0, d at 1) TRUE at 1: pass at 1. t1: a and c low:
# both vacuous at 1: no pass. t2: operand 1 vacuous (a low), operand 2 (c at 2, d at 3) TRUE at 3,
# nonvacuous (known at 2): pass at 3. t3: both vacuous: no pass.
property: (a |-> b) and (c |-> ##1 d)
clause: 16.7 16.12.5 16.12.7 16.14.3 16.14.8
class: interpretation I5
kind: cover
scope: attempt
sample  : 0 1 2 3
a       : 1 . . .
b       : 1 . . .
c       : 1 . 1 .
d       : . 1 . 1
outcome : T t T t
decided : 1 1 3 3
pass    : . 1 . 1
pending: 0

== cover_of_implication_with_several_antecedent_lengths
# cover of a ##[1:2] b |-> c: an attempt is TRUE only when the consequents of all its antecedent
# matches pass and the antecedent can match no more (two samples after the start at the latest).
# t0: ends 1 and 2, c at both: TRUE at 2 (pass). t1: ends 2 (c: passes) and 3 (b, c low:
# fails): FALSE at 3, no pass. t2, t3: a low: vacuous. t4: end 5 (c passes), b low at 6, so the
# antecedent ends: TRUE at 6 (pass; nonvacuous since sample 5). t5: a low. t6: end 7 passes,
# end 8 is beyond the trace: pending; the missing match does not exist, so it finalizes TRUE.
# t7: a low. Attempts t0 and t1 overlap at sample 2.
property: a ##[1:2] b |-> c
clause: 16.7 16.12.2 16.12.7 16.14.3 Annex F
class: normative
kind: cover
scope: attempt
sample  : 0 1 2 3 4 5 6 7
a       : 1 1 . . 1 . 1 .
b       : . 1 1 1 . 1 . 1
c       : . 1 1 . . 1 . 1
outcome : T F t t T t p t
decided : 2 3 2 3 6 5 . 7
pass    : . . 1 . . . 1 .
pending: 1
final-fail: 0

== cover_of_implication_where_one_consequent_passes_and_one_fails
# cover of a ##[1:2] b |-> c. t0: end 1 passes (b, c at 1), end 2 fails (b at 2, c low): FALSE at
# 2, no pass although one consequent passed. t1: a low.  t2: a low.
property: a ##[1:2] b |-> c
clause: 16.7 16.12.7 16.14.3
class: normative
kind: cover
scope: attempt
sample  : 0 1 2
a       : 1 . .
b       : . 1 1
c       : . 1 .
outcome : F t t
decided : 2 1 2
pending: 0

== cover_of_not_of_implication
# cover of not (a |-> b): TRUE (nonvacuous) only when the implication is FALSE.
# t0: a low: the implication is vacuously TRUE: not is FALSE. t1: a, b: not is FALSE.
# t2: a without b: the implication is FALSE, not is TRUE and nonvacuous: pass at 2.
property: not (a |-> b)
clause: 16.12.3 16.12.7 16.14.3 16.14.8
class: interpretation I5
kind: cover
scope: attempt
sample  : 0 1 2
a       : . 1 1
b       : . 1 .
outcome : f F T
decided : 0 1 2
pass    : . . 1
pending: 0

== cover_of_not_of_implication_with_delayed_consequent
# cover of not (a |-> ##[1:2] b). t0: b at 1: not FALSE at 1. t1: b low at 2 and 3: the
# implication is FALSE at 3, not is TRUE, nonvacuous (known since sample 1): pass at 3.
# t2: b at 4: not FALSE. t3, t4, t5: a low: not FALSE (vacuous).
property: not (a |-> ##[1:2] b)
clause: 16.7 16.12.3 16.12.7 16.14.3 16.14.8
class: interpretation I5
kind: cover
scope: attempt
sample  : 0 1 2 3 4 5
a       : 1 1 1 . . .
b       : . 1 . . 1 .
outcome : F T F f f f
decided : 1 3 4 3 4 5
pass    : . . . 1 . .
pending: 0

== cover_of_if_else_with_implication_branches
# cover of if (e) (a |-> b) else (c |-> d): only a TRUE, nonvacuous attempt of the selected
# branch counts. t0: e, a, b: pass at 0. t1: e, a without b: FALSE. t2: e, a low: vacuous.
# t3: !e, c, d: pass at 3. t4: !e, c without d: FALSE. t5: !e, c low: vacuous.
property: if (e) (a |-> b) else (c |-> d)
clause: 16.12.6 16.12.7 16.14.3 16.14.8
class: interpretation I5
kind: cover
scope: attempt
sample  : 0 1 2 3 4 5
e       : 1 1 1 . . .
a       : 1 1 . 1 1 1
b       : 1 . . . . .
c       : 1 1 1 1 1 .
d       : . . . 1 . .
outcome : T F t T F t
decided : 0 1 2 3 4 5
pass    : 1 . . 1 . .
pending: 0

== cover_of_or_of_implications_with_late_nonvacuity
# cover of (a |-> b) or (c ##1 e |-> d): rejected by the cover rule (nonvacuity can become
# known after the decision), so only the reference runs it.
# t0: a low: operand 1 vacuously TRUE: TRUE at 0. Operand 2 (c at 0, e at 1, d at 1) is
# nonvacuous only at 1, after the decision: TRUE nonvacuous in the end (T), but no pass at 0.
# t1: a, b: operand 1 TRUE and nonvacuous: pass at 1 (c low: operand 2 vacuous).
# t2, t3: a and c low: both operands vacuous: TRUE, vacuous (t), no pass.
property: (a |-> b) or (c ##1 e |-> d)
clause: 16.7 16.12.4 16.12.7 16.14.3 16.14.8
class: interpretation I5
kind: cover
support: oracle
scope: attempt
sample  : 0 1 2 3
a       : . 1 . .
b       : . 1 . .
c       : 1 . . .
e       : . 1 . .
d       : . 1 . .
outcome : T T t t
decided : 0 1 2 3
pass    : . 1 . .
pending: 0
