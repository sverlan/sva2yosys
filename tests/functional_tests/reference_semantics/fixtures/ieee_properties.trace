a       : 1 1 . 1 .
b       : . 1 . . .
outcome : F F F F p
decided : 2 2 4 4 .
fail    : . . 1 . 1
pending: 1
final-fail: 0

# ---------------------------------------------------------------- 16.12.12 until
== ieee_16_12_12_until_weak_p1
# evidence: derived
# 16.12.12 p1 (a until b): a holds at every tick from the start up to, not necessarily including, the
# first tick where b holds; if b holds at the starting tick, a need not hold. Attempts 0, 1, 2 meet b
# at sample 2 (a is low there: allowed). Attempts 3, 4: b never seen, a holds: weak, alive.
property: a until b
scope: attempt
clause: 16.12.12
class: normative
origin: IEEE 1800-2017 §16.12.12 p1, re-expressed
sample  : 0 1 2 3 4
a       : 1 1 . 1 1
b       : . . 1 . .
outcome : T T T p p
decided : 2 2 2 . .
pass    : . . 1 . .
pending: 2
final-fail: 0

