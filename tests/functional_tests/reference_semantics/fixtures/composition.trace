== nested_products
# (b and ##1 c) has length 2, as has ##1 d.
property: a |-> (b and (##1 c)) intersect (##1 d)
clause: 16.7 16.9.5 16.9.6 16.12.7
class: normative
signals: a b c d
sample : 0 1 2
a      : 1 . .
b      : 1 . .
c      : . 1 .
d      : . 1 .
pass   : . 1 .

== within_inside_and
# The within ends at 2 (its outer end), the and at the later end, 2.
property: a |-> (b within (##2 c)) and (##1 d)
clause: 16.7 16.9.5 16.9.10 16.12.7
class: normative
signals: a b c d
sample : 0 1 2 3
a      : 1 . . .
b      : . 1 . .
c      : . . 1 .
d      : . 1 . .
pass   : . . 1 .

