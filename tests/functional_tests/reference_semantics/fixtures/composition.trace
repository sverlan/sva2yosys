== nullable_throughout_takes_the_empty_path
# The empty match of the throughout fuses ##1 d onto the trigger sample: d at 0 suffices.
property: a |-> (e throughout b[*0:1]) ##1 d
clause: 16.7 16.9.2 16.9.9 16.12.7
class: normative
signals: a e b d
sample : 0 1
a      : 1 .
e      : . .
b      : . .
d      : 1 .
pass   : 1 .

