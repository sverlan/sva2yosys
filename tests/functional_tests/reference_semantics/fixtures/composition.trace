# Sequence and, intersect, within, throughout (IEEE 1800 §16.9.5-16.9.10).

== and_ends_at_the_later_end
# b ends at 0 and (##2 d) at 2: the match ends at the later end, 2.
property: a |-> b and (##2 d)
clause: 16.7 16.9.5 16.12.7
class: normative
sample : 0 1 2 3
a      : 1 . . .
b      : 1 . . .
d      : . . 1 .
pass   : . . 1 .

== and_fails_when_one_operand_fails
property: a |-> (b ##1 c) and (##1 d)
clause: 16.7 16.9.5 16.12.7
class: normative
sample : 0 1 2
a      : 1 . .
b      : 1 . .
c      : . . .
d      : . 1 .
fail   : . 1 .

== intersect_needs_the_same_end
# b[*1:3] and ##2 c: only the length-3 match of b[*1:3] ends with c at sample 2.
property: a |-> b[*1:3] intersect (##2 c)
clause: 16.7 16.9.2 16.9.6 16.12.7
class: normative
sample : 0 1 2 3
a      : 1 . . .
b      : 1 1 1 .
c      : . . 1 .
pass   : . . 1 .

== intersect_fails_when_lengths_never_meet
# Lengths 2 and 3 never meet: dead at the trigger sample (docs/semantics.md section 3).
property: a |-> (b ##1 b) intersect (##2 c)
clause: 16.7 16.9.6 16.12.7
class: normative
sample : 0 1 2
a      : 1 . .
b      : 1 1 1
c      : . . 1
fail   : 1 . .

== within_inner_inside_outer
# c inside a 4-sample window starting at the trigger.
property: a |-> c within (##3 d)
clause: 16.7 16.9.10 16.12.7
class: normative
sample : 0 1 2 3 4
a      : 1 . . . .
c      : . . 1 . .
d      : . . . 1 .
pass   : . . . 1 .

== within_fails_without_the_inner_match
property: a |-> c within (##2 d)
clause: 16.7 16.9.10 16.12.7
class: normative
sample : 0 1 2 3
a      : 1 . . .
c      : . . . .
d      : . . 1 .
fail   : . . 1 .

== throughout_holds_on_every_sample
property: a |-> e throughout (##2 b)
clause: 16.7 16.9.9 16.12.7
class: normative
signals: a e b
sample : 0 1 2 3
a      : 1 . 1 .
e      : 1 1 1 .
b      : . . 1 .
fail   : . . . 1
pass   : . . 1 .

== and_then_fusion
# (b and ##1 d) ends at 1; ##0 c needs c at that same sample.
property: a |-> (b and (##1 d)) ##0 c
clause: 16.7 16.9.5 16.12.7
class: normative
signals: a b d c
sample : 0 1 2
a      : 1 . .
b      : 1 . .
d      : . 1 .
c      : . 1 .
pass   : . 1 .

== and_then_fusion_fails
property: a |-> (b and (##1 d)) ##0 c
clause: 16.7 16.9.5 16.12.7
class: normative
signals: a b d c
sample : 0 1 2
a      : 1 . .
b      : 1 . .
d      : . 1 .
c      : . . .
fail   : . 1 .

== and_with_several_ends_in_both_operands
# The and ends at 1 or 2 (the later of b's end 0/1 and c's end 1/2): d at 3 matches.
property: a |-> (b[*1:2] and c[*2:3]) ##1 d
clause: 16.7 16.9.2 16.9.5 16.12.7
class: normative
signals: a b c d
sample : 0 1 2 3 4
a      : 1 . . . .
b      : 1 1 . . .
c      : 1 1 1 . .
d      : . . . 1 .
pass   : . . . 1 .

== and_with_several_ends_fails_when_the_last_dies
property: a |-> (b[*1:2] and c[*2:3]) ##1 d
clause: 16.7 16.9.2 16.9.5 16.12.7
class: normative
signals: a b c d
sample : 0 1 2 3 4
a      : 1 . . . .
b      : 1 1 . . .
c      : 1 1 1 . .
d      : . . . . .
fail   : . . . 1 .

== repeated_intersect
# Each repetition is b,b with c at its second sample.
property: a |-> (b[*1:2] intersect (##1 c))[*2]
clause: 16.7 16.9.2 16.9.6 16.12.7
class: normative
signals: a b c
sample : 0 1 2 3 4
a      : 1 . . . .
b      : 1 1 1 1 .
c      : . 1 . 1 .
pass   : . . . 1 .

== repeated_intersect_fails_in_the_second_repetition
property: a |-> (b[*1:2] intersect (##1 c))[*2]
clause: 16.7 16.9.2 16.9.6 16.12.7
class: normative
signals: a b c
sample : 0 1 2 3 4
a      : 1 . . . .
b      : 1 1 1 1 .
c      : . 1 . . .
fail   : . . . 1 .

