# Property and (IEEE 1800 §16.12.5) of properties that are not both sequences: an attempt
# fails at the earlier of its operands' failures. Every expectation is scoped to "up to and
# including the first failure" (scope: first-failure): the lowering is one monitor per
# conjunct, whose failures are OR-ed, and the conjunction's own success is not defined (a
# cover of it is rejected), so there is no pass row.

== and_first_operand_fails_first
# (a |-> b) fails at 0 and at 3; (c |-> ##1 d) fails at 2. The first failure is 0.
property: (a |-> b) and (c |-> ##1 d)
clause: 16.7 16.12.5 16.12.7
class: normative
signals: a b c d
scope: first-failure
sample : 0 1 2 3 4
a      : 1 . . 1 .
b      : . . . . .
c      : . 1 . . .
d      : . . . . .
fail   : 1 . . . .

== and_second_operand_fails_first
# (a |-> b) fails at 3 only; (c |-> ##1 d) fails at 1. The first failure is 1.
property: (a |-> b) and (c |-> ##1 d)
clause: 16.7 16.12.5 16.12.7
class: normative
signals: a b c d
scope: first-failure
sample : 0 1 2 3 4
a      : . . . 1 .
b      : . . . . .
c      : 1 . . . .
d      : . . . . .
fail   : . 1 . . .

== and_both_hold
# c at 1 and d at 2; a and b together at 0: no operand fails.
property: (a |-> b) and (c |-> ##1 d)
clause: 16.7 16.12.5 16.12.7
class: normative
signals: a b c d
scope: first-failure
sample : 0 1 2 3
a      : 1 . . .
b      : 1 . . .
c      : . 1 . .
d      : . . 1 .

== and_both_fail_at_the_same_sample
property: (a |-> b) and (a |-> c)
clause: 16.12.5 16.12.7
class: normative
signals: a b c
scope: first-failure
sample : 0 1 2
a      : 1 . .
fail   : 1 . .

== and_with_not
# a |-> b holds at 0. not (c ##1 d): the attempt at 1 sees c at 1 and d at 2, a match, so it
# fails at 2. The attempts at 0 and 2 see c low.
property: (a |-> b) and not (c ##1 d)
clause: 16.7 16.12.3 16.12.5 16.12.7
class: normative
signals: a b c d
scope: first-failure
sample : 0 1 2 3
a      : 1 . . .
b      : 1 . . .
c      : . 1 . .
d      : . . 1 .
fail   : . . 1 .

== and_of_three_is_flat
# (x and y) and z: the first failure is z's, at 1 (a at 1, d low).
property: (a |-> b) and (a |-> c) and (a |-> d)
clause: 16.12.5 16.12.7
class: normative
signals: a b c d
scope: first-failure
sample : 0 1 2
a      : . 1 .
b      : . 1 .
c      : . 1 .
fail   : . 1 .

== and_with_a_strong_operand
# strong(a ##1 b): the attempt at 0 dies at 1 (b low). (c |-> d) fails at 2 only. First: 1.
property: strong(a ##1 b) and (c |-> d)
clause: 16.7 16.12.2 16.12.5 16.12.7
class: normative
signals: a b c d
scope: first-failure
sample : 0 1 2
a      : 1 . .
c      : . . 1
fail   : . 1 .

== and_consequent_distributes
# a |-> (not b and not c) is (a |-> not b) and (a |-> not c): at 0, c holds, so it fails.
property: a |-> (not b and not c)
clause: 16.12.3 16.12.5 16.12.7
class: normative
signals: a b c
scope: first-failure
sample : 0 1 2
a      : 1 . .
c      : 1 . .
fail   : 1 . .

== and_consequent_distributes_holds
# a at 0 and 1 with b, c low at those samples.
property: a |-> (not b and not c)
clause: 16.12.3 16.12.5 16.12.7
class: normative
signals: a b c
scope: first-failure
sample : 0 1 2
a      : 1 1 .
b      : . . 1
c      : . . 1

== and_disable_hides_both_operands
# The attempts at 0 would fail at 3 (first operand) and at 1 (second); rst_n falls at 1,
# before the first and with the second, so both are disabled.
property: (a |-> ##3 b) and (c |-> ##1 d)
clause: 16.7 16.12 16.12.5 16.12.7
class: normative
disable: !rst_n
signals: a b c d rst_n
scope: first-failure
sample : 0 1 2 3
rst_n  : 1 . 1 1
a      : 1 . . .
c      : 1 . . .

== and_disable_hides_only_the_later_failure
# The first operand would fail at 3, where rst_n falls: disabled. The second fails at 2,
# before the disable.
property: (a |-> ##3 b) and (c |-> ##1 d)
clause: 16.7 16.12 16.12.5 16.12.7
class: normative
disable: !rst_n
signals: a b c d rst_n
scope: first-failure
sample : 0 1 2 3 4
rst_n  : 1 1 1 . 1
a      : 1 . . . .
c      : . 1 . . .
fail   : . . 1 . .
